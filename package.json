{
  "name": "sleepycode-agent",
  "displayName": "SleepyCode",
  "description": "SleepyAI's coding agent for Visual Studio Code.",
  "version": "0.10.11",
  "publisher": "TahsinArafat",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TahsinArafat/SleepyCode-VSCode"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Programming Languages",
    "Chat",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sleepyai",
    "ai",
    "coding agent",
    "codex",
    "chat",
    "copilot",
    "automation",
    "llm",
    "mcp",
    "vscode extension",
    "developer tools"
  ],
  "activationEvents": [
    "onView:sleepycode.chat",
    "onUri",
    "onCommand:sleepycode.openChat",
    "onCommand:sleepycode.testSystemNotification"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "keybindings": [
      {
        "command": "sleepycode.chat.stop",
        "key": "ctrl+alt+period",
        "mac": "cmd+alt+period",
        "when": "view == sleepycode.chat"
      },
      {
        "command": "sleepycode.chat.stop",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "view == sleepycode.chat"
      },
      {
        "command": "sleepycode.chat.clearComposer",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "view == sleepycode.chat && !suggestWidgetVisible"
      },
      {
        "command": "sleepycode.chat.newLine",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "view == sleepycode.chat"
      },
      {
        "command": "sleepycode.chat.copyLast",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "view == sleepycode.chat"
      },
      {
        "command": "sleepycode.chat.shortcuts",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "view == sleepycode.chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sleepycode",
          "title": "SleepyCode",
          "icon": "media/sleepycode-o.svg"
        }
      ]
    },
    "views": {
      "sleepycode": [
        {
          "type": "webview",
          "id": "sleepycode.chat",
          "name": "SleepyCode"
        }
      ]
    },
    "commands": [
      {
        "command": "sleepycode.openChat",
        "title": "SleepyCode: Open Chat",
        "icon": "media/sleepycode-o.svg"
      },
      {
        "command": "sleepycode.focus",
        "title": "SleepyCode: Focus Chat",
        "icon": "media/sleepycode-o.svg"
      },
      {
        "command": "sleepycode.settings",
        "title": "SleepyCode: Open Settings"
      },
      {
        "command": "sleepycode.usage",
        "title": "SleepyCode: Usage & Billing"
      },
      {
        "command": "sleepycode.memory",
        "title": "SleepyCode: Open Project Memory"
      },
      {
        "command": "sleepycode.marketplace",
        "title": "SleepyCode: Skill Marketplace"
      },
      {
        "command": "sleepycode.clear",
        "title": "SleepyCode: New Chat"
      },
      {
        "command": "sleepycode.testSystemNotification",
        "title": "SleepyCode: Test System Notification"
      },
      {
        "command": "sleepycode.worktrees",
        "title": "SleepyCode: Git Worktrees Dashboard"
      },
      {
        "command": "sleepycode.index",
        "title": "SleepyCode: Repository Index & Search"
      },
      {
        "command": "sleepycode.agents",
        "title": "SleepyCode: Custom Agents"
      },
      {
        "command": "sleepycode.tasks",
        "title": "SleepyCode: Scheduled Tasks & Hooks"
      },
      {
        "command": "sleepycode.checkpoints",
        "title": "SleepyCode: Undo History"
      },
      {
        "command": "sleepycode.signIn",
        "title": "SleepyCode: Sign in to SleepyAI"
      },
      {
        "command": "sleepycode.settingsWindow",
        "title": "SleepyCode: Settings (new window)"
      },
      {
        "command": "sleepycode.openLogs",
        "title": "SleepyCode: Show Logs"
      },
      {
        "command": "sleepycode.copyLogs",
        "title": "SleepyCode: Copy Logs to Clipboard"
      },
      {
        "command": "sleepycode.copyMemoryReport",
        "title": "SleepyCode: Copy Memory Report"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "sleepycode.openChat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SleepyCode",
      "properties": {
        "sleepycode.model": {
          "type": "string",
          "default": "",
          "description": "Selected model ID for the active provider. Choose it from the sidebar."
        },
        "sleepycode.maxSteps": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum tool-loop steps per iteration. Defaults to 200. Set to 0 for unlimited tasks. When the limit pauses unfinished work, SleepyCode offers Continue iteration."
        },
        "sleepycode.maxPersistedReasoning": {
          "type": "number",
          "default": 32000,
          "minimum": 3000,
          "maximum": 200000,
          "description": "Maximum characters of previous thinking kept for later model requests. Some reasoning models need this history. Default 32000. Configurable from Settings → Advanced."
        },
        "sleepycode.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "Optional custom instructions appended to the system prompt."
        },
        "sleepycode.approvalMode": {
          "type": "string",
          "enum": [
            "ask",
            "edits",
            "autonomous"
          ],
          "default": "ask",
          "description": "Controls whether file edits and commands require confirmation. 'Auto edits' auto-applies file edits but still asks before every command; 'Open access' runs everything without confirmation."
        },
        "sleepycode.searxngUrl": {
          "type": "string",
          "default": "http://localhost:8888",
          "description": "Base URL for a SearXNG instance with JSON output enabled. Defaults to a local instance on port 8888; leave empty to disable web search."
        },
        "sleepycode.mcpServers": {
          "type": "string",
          "default": "{}",
          "description": "JSON object of MCP servers. Each entry may use an HTTP/SSE URL or a stdio command with args, env, and cwd."
        },
        "sleepycode.extraFreeModels": {
          "type": "string",
          "default": "",
          "description": "Additional comma-separated model IDs to show for the active provider when discovery is incomplete or unavailable."
        },
        "sleepycode.systemNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show native SleepyCode system notifications (task completed, approval needed, task failed) when VS Code is not focused."
        },
        "sleepycode.worktrees": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Git worktrees isolation feature and its agent tools."
        },
        "sleepycode.repoIndex": {
          "type": "boolean",
          "default": false,
          "description": "Build a local repository index (file paths, symbols, imports) for semantic and symbol search. Off by default: without it the agent still gets the workspace folder, OS, and git context, and reads files on demand with its normal tools. Turn it on in Settings → Indexing for large repositories."
        },
        "sleepycode.hooks": {
          "type": "boolean",
          "default": true,
          "description": "Enable lifecycle hook rules that can allow, block, warn, or require approval for tool calls and edits."
        },
        "sleepycode.tasksHooks": {
          "type": "boolean",
          "default": true,
          "description": "Enable scheduled tasks and the lifecycle hooks engine."
        },
        "sleepycode.browserTesting": {
          "type": "boolean",
          "default": true,
          "description": "Enable headless browser testing tools (requires the Playwright runtime)."
        },
        "sleepycode.customAgents": {
          "type": "boolean",
          "default": true,
          "description": "Enable custom agent definitions with per-agent model, prompt, and tool routing."
        },
        "sleepycode.useCli": {
          "type": "boolean",
          "default": false,
          "description": "Experimental: run chats on the SleepyCode CLI when it is installed and can serve this workspace, and list the CLI's own models in the composer. Off by default so the stable local agent stays in charge. Configure from Settings → Advanced."
        }
      }
    }
  },
  "scripts": {
    "check": "npm run build && tsc --noEmit && node scripts/verify.mjs && node scripts/logic-check.mjs && npm test && npm run test:core && node scripts/verify-notifier.mjs",
    "check:webview": "npm run build && node scripts/verify-webview-bundles.mjs",
    "test": "node --test 'test/**/*.test.mjs'",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run verify:release && npm run check && node scripts/verify-webview-bundles.mjs && vsce package",
    "test:core": "node --experimental-strip-types --test test/*.direct.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check:perf": "npm run build && node scripts/perf-probe.mjs --check && node scripts/ui-shots.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.30",
    "@ai-sdk/openai-compatible": "^3.0.26",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ai": "^7.0.57",
    "katex": "^0.18.7",
    "marked": "^18.1.1",
    "playwright-core": "^1.63.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.106.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
